{
  "name": "array-fm",
  "version": "1.0.0",
  "description": "Perform filter + map or map + filter operations on an array in one go",
  "keywords": [
    "array",
    "filter",
    "flatmap",
    "map",
    "reduce"
  ],
  "homepage": "https://github.com/alrico88/array-fm#readme",
  "bugs": {
    "url": "https://github.com/alrico88/array-fm/issues"
  },
  "license": "MIT",
  "author": "Alberto Rico",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrico88/array-fm.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "test": "vp test",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0",
      "onFail": "download"
    }
  }
}
